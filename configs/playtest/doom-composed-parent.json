  "capture_every": 5,
  "policy": {
    "goal": "For the full 60-second interval, explore the Doom map and eliminate as many enemies as possible while surviving. Seek more enemies through doors and openings after clearing the room. Continue until the time budget ends or the player dies; do not finish after two kills.",
    "instructions": "Use fresh facts and measured deltas. Positive bearing means turn right; positive aimPitchError means aim up. Select simultaneous movement, look and trigger controls. Parent gives objectives and route context, not current angles: use fresh enemy bearings. If repeated forward actions produce near-zero movement, back/strafe and turn to find an opening; do not keep pushing. Aim at living visible enemies, correct pitch too. Fire when weaponReady and current assistedHit is an Entity matching a live enemy; when aim assist is inactive use aimHit. A StaticMesh hit means the shot is obstructed: reposition. Move and aim together; strafe under fire. Seek enemies/pickups and use closed doors through ordinary X. Continue after kills until time ends or death. A blocked path alone is not an unexpected state.",
    "budget_ms": 60000,
    "max_actions": 0,
    "decision_timeout_ms": 5000,
    "minimum_confidence": 0,
    "stall_actions": 0,
    "progress_pointers": [
      "/facts/combat.observe/player/position",
      "/facts/combat.observe/player/yawDegrees",
      "/facts/combat.observe/player/pitchDegrees",
      "/facts/combat.observe/player/kills"
    ],
    "stop_when": [
      {
        "pointer": "/facts/combat.observe/player/dead",
        "operator": "eq",
        "value": true,
        "reason": "player_dead"
      }
    ],
    "tactics": [
